DEBUG=True
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_DOMAIN=127.0.0.1:8000
SITE_PROTOCOL=http
DJANGO_ADMIN_URL=admin/
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=False
TRUSTED_PROXY_IPS=
NUM_PROXIES=0

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=double_bite_db
DB_USER=double_bite
DB_PASSWORD=change_this_to_a_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_this_to_a_secure_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:change_this_to_a_secure_redis_password@localhost:6379/0

# --- Orders & Delivery ---
MIN_ORDER_AMOUNT=200
FREE_DELIVERY_THRESHOLD=500.00
DELIVERY_FEE=65.00

# --- Stripe Payments ---
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_ORDER_SUCCESS_STATUS=PREPARING

# --- Mistral AI ---
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-8b-2512
MISTRAL_TEMPERATURE=0.3
MISTRAL_MAX_TOKENS=1024

# --- Support Desk & Working Hours ---
SUPPORT_WORK_START_HOUR=10
SUPPORT_WORK_END_HOUR=22

# --- Email / Mailpit ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Double Bite <noreply@doublebite.ua>
ADMIN_EMAIL=admin@doublebite.ua
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- OAuth2 (django-allauth) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
