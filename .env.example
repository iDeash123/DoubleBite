DB_ENGINE=django.db.backends.postgresql
DB_NAME=double_bite_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


REDIS_URL=redis://localhost:6379/0


