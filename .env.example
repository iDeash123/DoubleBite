VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433

# --- Stripe Payments ---
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
